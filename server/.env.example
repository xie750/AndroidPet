# The bridge rejects requests unless this independent phone-to-PC token matches.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FEIWU_CLIENT_TOKEN=replace-with-a-long-random-token

# Protects the local management page and encrypts provider keys at rest.
# Generate ADMIN_TOKEN like CLIENT_TOKEN. Generate ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FEIWU_ADMIN_TOKEN=replace-with-a-different-long-random-token
FEIWU_CONFIG_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
FEIWU_ADMIN_ALLOW_REMOTE=false

# Third-party OpenAI-compatible provider. Keep the real key only in server/.env.
FEIWU_PROVIDER_BASE_URL=https://api.deepseek.com
FEIWU_PROVIDER_CHAT_PATH=/chat/completions
FEIWU_PROVIDER_API_KEY=
FEIWU_PROVIDER_MODEL=deepseek-flash

# Provider request behavior.
FEIWU_PROVIDER_TIMEOUT_SECONDS=35
FEIWU_PROVIDER_MAX_TOKENS=400
FEIWU_PROVIDER_TEMPERATURE=0.3
FEIWU_PROVIDER_RETRIES=2

# Listen on the LAN so the phone can connect. Restrict the firewall to Private networks.
FEIWU_SERVER_HOST=0.0.0.0
FEIWU_SERVER_PORT=8765
FEIWU_LOG_LEVEL=info
FEIWU_REQUESTS_PER_MINUTE=20
FEIWU_DATA_DIR=./data

